# Copy this file to .env and fill in your own values before running the server.

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/crewframe
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crewframe
MONGODB_URI=mongodb://127.0.0.1:27017/crewframe

# Secret used to sign admin JWT sessions. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# How long an admin login session stays valid.
JWT_EXPIRES_IN=7d

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API
# (the public site + the admin panel, in dev and in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# The contract/admin email address. Seeded as the one and only admin login.
ADMIN_EMAIL=hello@crewframeagency.com

# Initial admin password, used ONLY the first time `npm run seed` creates the
# admin account. Change it from the admin panel immediately after first login.
ADMIN_INITIAL_PASSWORD=CrewFrame#2026
